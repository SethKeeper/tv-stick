[Unit]
Description=Set NordVPN up for the TV stick (once)
Requires=nordvpnd.service
After=nordvpnd.service
ConditionPathExists=/usr/bin/nordvpn
ConditionPathExists=!/var/lib/tv/nordvpn-setup-done

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/usr/local/sbin/tv-nordvpn-setup

[Install]
WantedBy=multi-user.target
