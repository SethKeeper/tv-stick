#!/usr/bin/env python3
"""Keeps the focused Firefox window full screen. Firefox leaves full screen when
a video does, which would leave its toolbar showing on the TV."""
import json
import subprocess
import time


def main():
    last = {}
    while True:
        try:
            proc = subprocess.Popen(["swaymsg", "-t", "subscribe", "-m", '["window"]'],
                                    stdout=subprocess.PIPE, text=True)
        except OSError:
            time.sleep(2)
            continue
        for line in proc.stdout:
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            con = ev.get("container") or {}
            if ev.get("change") not in ("new", "focus", "fullscreen_mode"):
                continue
            if con.get("app_id") != "firefox" or not con.get("focused") or con.get("fullscreen_mode"):
                continue
            cid = con.get("id")
            now = time.monotonic()
            if now - last.get(cid, 0) < 0.4:
                continue
            last[cid] = now
            time.sleep(0.15)
            subprocess.run(["swaymsg", "[con_id=%d] fullscreen enable" % cid],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        proc.wait()
        time.sleep(1)


main()
