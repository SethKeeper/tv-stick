# TV session: one browser window, full screen. No bars, no gaps, and no
# shortcuts except the remote's volume keys.
output * bg #050608 solid_color
output * scale 1
default_border none
default_floating_border none
focus_follows_mouse no
seat seat0 hide_cursor 3000
seat seat0 hide_cursor when-typing enable
seat seat0 xcursor_theme Adwaita 48

for_window [app_id="firefox"] fullscreen enable

bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

exec /usr/local/bin/tv-browser
